# Copy to `.env` and adjust. Everything here can also be passed as a CLI flag (run with `--help`).

# Matches `docker-compose.yml`. Also used by `sqlx` at compile time and by `cargo test`
# (`#[sqlx::test]` creates a throwaway database per test on this server).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/template

# Address the HTTP server listens on.
BIND_ADDRESS=0.0.0.0:8000

# Set to true when the app is served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Log filter, see https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html
RUST_LOG=template=debug,tower_http=debug

# Build against the committed `.sqlx/` query data instead of a live database (e.g. in CI).
# SQLX_OFFLINE=true
